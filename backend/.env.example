# Node Environment
NODE_ENV=development
PORT=8000

# Database
MONGODB_URI=mongodb://localhost:27017/agriyield

# Frontend
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Magic Labs (Passwordless Authentication)
MAGIC_API_KEY=pk_live_your_magic_api_key_here
MAGIC_SECRET_KEY=sk_live_your_magic_secret_key_here

# IPFS (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret

# Blockchain
INFURA_RPC=https://mainnet.infura.io/v3/your_infura_project_id
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Email Configuration (SMTP)
# For Gmail: smtp.gmail.com, Port: 587
# For SendGrid: smtp.sendgrid.net, Port: 587
# For Outlook: smtp-mail.outlook.com, Port: 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=AgriYield <noreply@agriyield.com>

# Smart Contracts
